# ==============================================================================
# SlotBridge Korea — Environment Configuration Example (NO SECRETS)
# ==============================================================================

# 1. Cloudflare Environment
ENVIRONMENT=development
CLOUDFLARE_D1_DATABASE_ID=d1_sbk_database_mock_id
CLOUDFLARE_ACCOUNT_ID=mock_account_id

# 2. Security & Encryption
# Must be a 32-byte (256-bit) base64-encoded key injected via `wrangler secret put`
# DO NOT put raw secrets in this file or commit to version control.
ENCRYPTION_KEY_ID=sec_key_v1_placeholder
ENCRYPTION_ALGORITHM=AES-256-GCM

# 3. Authentication & Access Control
ADMIN_API_SECRET_HASH=sha256_placeholder_hash
PARTNER_JWT_SECRET_ID=jwt_key_v1_placeholder

# 4. FinOps & Fail-Closed Safeguards
FAIL_CLOSED_THRESHOLD=0.80 # 80% quota circuit breaker
SYSTEM_KILL_SWITCH=FALSE    # Emergency global shutdown toggle

# 5. Domain & Routing
BASE_URL=https://saas-benchmarks.pages.dev
CORS_ALLOWED_ORIGINS=https://saas-benchmarks.pages.dev
