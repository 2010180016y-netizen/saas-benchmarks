{
  "name": "saas-benchmarks",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "slotbridge-db",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
